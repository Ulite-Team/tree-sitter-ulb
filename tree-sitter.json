{
  "grammars": [
    {
      "name": "ulb",
      "camelcase": "ULB",
      "scope": "source.ulb",
      "path": ".",
      "file-types": ["ulb"],
      "highlights": "queries/highlights.scm",
      "folds": "queries/folds.scm",
      "indents": "queries/indents.scm",
      "injection-regex": "ulb"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "GPL-3.0",
    "description": "tree-sitter grammar for the ulb build DSL (see docs/grammar.md)",
    "authors": [
      {
        "name": "Ulite Team"
      }
    ]
  },
  "bindings": {
    "c": true,
    "go": false,
    "node": true,
    "python": false,
    "rust": true,
    "swift": false
  },
  "generate": {
    "abi": 15
  }
}
